# Build stage - same as before
FROM rust:slim as builder

# Install all build dependencies in a single layer
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    tar \
    ca-certificates \
    build-essential \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 20 (LTS)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Download and install latest Binaryen
RUN LATEST_URL=$(curl -s https://api.github.com/repos/WebAssembly/binaryen/releases/latest | \
    grep "browser_download_url.*x86_64-linux.tar.gz\"" | grep -v "sha256" | head -1 | cut -d '"' -f 4) && \
    echo "Downloading Binaryen: $LATEST_URL" && \
    wget -q -O binaryen.tar.gz "$LATEST_URL" && \
    tar -xzf binaryen.tar.gz && \
    BINARYEN_DIR=$(tar -tzf binaryen.tar.gz | head -1 | cut -f1 -d"/") && \
    mv "$BINARYEN_DIR" /opt/binaryen && \
    rm binaryen.tar.gz

ENV PATH="/opt/binaryen/bin:${PATH}"

# Install Rust toolchain and dependencies
RUN cargo install trunk --locked && \
    rustup target add wasm32-unknown-unknown

WORKDIR /app

# Copy dependency files first for better Docker layer caching
COPY Cargo.toml Cargo.lock ./
COPY front/web/package*.json front/web/Trunk.toml ./front/web/

WORKDIR /app/front/web
RUN npm ci --production=false --prefer-offline --no-audit

WORKDIR /app
COPY front ./front
COPY back ./back
COPY shared ./shared
COPY testing ./testing

# Build CSS and frontend
WORKDIR /app/front/web
ARG DOCKER_ENV
ARG FRONTEND_PORT
ARG GIT_COMMIT
ARG BUILD_DATE
ARG BUILD_VERSION
ENV DOCKER_ENV=${DOCKER_ENV}
ENV FRONTEND_PORT=${FRONTEND_PORT:-50003}
ENV GIT_COMMIT=${GIT_COMMIT}
ENV BUILD_DATE=${BUILD_DATE}
ENV BUILD_VERSION=${BUILD_VERSION}

# CRITICAL: Clean ALL caches to ensure fresh build
# Even with Docker --no-cache, Cargo and Trunk have their own caches
# This ensures source code changes are always picked up
# Trunk caches in .stage/ and dist/, Cargo caches in target/
RUN echo "=== CLEANING ALL CACHES ===" && \
    cargo clean --package frontend || true && \
    rm -rf /app/_build/frontend-dist .stage dist target/wasm32-unknown-unknown/release/frontend* target/wasm32-unknown-unknown/debug/frontend* || true && \
    find . -name "*.wasm" -type f -delete 2>/dev/null || true && \
    find .. -path "*/frontend/.stage/*" -type f -delete 2>/dev/null || true && \
    find .. -path "*/frontend/dist/*" -type f -delete 2>/dev/null || true && \
    echo "✅ All caches cleaned" && \
    echo "=== CACHE CLEANUP COMPLETE ==="

# CRITICAL: Clean Trunk's output directory RIGHT BEFORE building to prevent reusing old WASM files
RUN echo "=== CLEANING TRUNK OUTPUT (FINAL CLEAN) ===" && \
    rm -rf /app/_build/frontend-dist .stage dist 2>/dev/null || true && \
    find .. -name "*.wasm" -type f -delete 2>/dev/null || true && \
    echo "✅ Output directory cleaned - ready for fresh build" && \
    npm run build:css:prod && \
    mkdir -p /app/_build/frontend-dist && \
    trunk build --release --no-default-features --dist /app/_build/frontend-dist

# Verify build output
RUN echo "Checking build output..." && \
    ls -lah /app/_build/frontend-dist/ 2>/dev/null || (echo "ERROR: No dist directory found at /app/_build/frontend-dist" && exit 1)

# Create version.json (Trunk does not emit it; footer/version endpoint expect it)
RUN printf '%s\n' "{\"name\":\"frontend\",\"version\":\"${BUILD_VERSION:-}\",\"build_date\":\"${BUILD_DATE:-unknown}\",\"git_commit\":\"${GIT_COMMIT:-unknown}\",\"source_hash\":\"${GIT_COMMIT:-unknown}\",\"build_version\":\"${BUILD_VERSION:-}\"}" \
    > /app/_build/frontend-dist/version.json && \
    echo "✅ version.json created" && cat /app/_build/frontend-dist/version.json

# Optimize WASM
RUN DIST_DIR="/app/_build/frontend-dist" && \
    if [ -n "$(find "$DIST_DIR" -name '*_bg.wasm' -type f | head -1)" ]; then \
        WASM_INPUT=$(find "$DIST_DIR" -name '*_bg.wasm' -type f | head -1) && \
        echo "Found WASM file: $WASM_INPUT" && \
        wasm-opt --enable-bulk-memory --enable-nontrapping-float-to-int -Oz \
            -o "$DIST_DIR/frontend_bg.optimized.wasm" "$WASM_INPUT" && \
        echo "✅ WASM optimized"; \
    else \
        echo "⚠️  No WASM file found to optimize"; \
    fi

# Sanity check: list a few output files
RUN echo "=== FRONTEND DIST OUTPUT (HEAD) ===" && ls -lah /app/_build/frontend-dist/ | head -15

# Final stage: Caddy (much simpler than nginx!)
FROM caddy:2-alpine

# Copy built files
COPY --from=builder /app/_build/frontend-dist /usr/share/caddy

# Build metadata labels (fallback if version.json is unavailable/unknown)
LABEL org.opencontainers.image.revision=$GIT_COMMIT \
      org.opencontainers.image.created=$BUILD_DATE \
      org.opencontainers.image.source_hash=$SOURCE_HASH

# Inject build metadata into version.json if present
ARG BUILD_DATE
ARG GIT_COMMIT
ARG SOURCE_HASH
RUN if [ -f /usr/share/caddy/version.json ]; then \
        sed -i "s/\"git_commit\": \"[^\"]*\"/\"git_commit\": \"${GIT_COMMIT:-unknown}\"/" /usr/share/caddy/version.json && \
        sed -i "s/\"build_date\": \"[^\"]*\"/\"build_date\": \"${BUILD_DATE:-unknown}\"/" /usr/share/caddy/version.json && \
        sed -i "s/\"source_hash\": \"[^\"]*\"/\"source_hash\": \"${SOURCE_HASH:-unknown}\"/" /usr/share/caddy/version.json && \
        echo "✅ version.json metadata updated"; \
    fi

# Caddyfile - MUCH simpler than nginx config!
# Caddy automatically handles:
# - SPA routing (try_files equivalent)
# - WASM MIME types
# - Gzip compression
# - Security headers
RUN cat > /etc/caddy/Caddyfile <<'EOF'
{
    # Global options
    auto_https off  # Disable auto HTTPS in Docker (Traefik handles it)
}

:${FRONTEND_PORT} {
    root * /usr/share/caddy
    file_server
    
    # SPA routing - all routes go to index.html
    try_files {path} /index.html
    
    # WASM files - correct MIME type
    @wasm {
        path *.wasm
    }
    handle @wasm {
        header Content-Type "application/wasm"
        file_server
    }
    
    # Static assets with caching
    @static {
        path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg
    }
    handle @static {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    
    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        -Server  # Hide server name
    }
}
EOF

# Set default port
ENV FRONTEND_PORT=50003

EXPOSE 50003 8080

# Caddy automatically handles env var substitution in Caddyfile!
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]

