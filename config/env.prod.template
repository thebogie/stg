# Production-like: Docker stack (SurrealDB + Redis + backend).
# Copy to .env.prod: ./config/setup-env.sh prod
# Used by: scripts/ci.sh, scripts/start-back.sh, docker compose --env-file config/.env.prod

RUST_ENV=production
RUST_LOG=info

# Data dir for Docker volumes (use absolute path; scripts resolve ./docker-data to absolute)
VOLUME_PATH=./docker-data

# Ports (host mapping: SurrealDB 50001, backend 50002, frontend 50003)
SURREALDB_PORT=50001
BACKEND_PORT=50002
FRONTEND_PORT=50003
REDIS_PORT=6379

# SurrealDB (inside containers: ws://surrealdb:8000; set in compose)
SURREAL_NS=stg_rd
SURREAL_DB=stg_rd
SURREAL_USER=root
SURREAL_PASSWORD=root

# Optional API keys (passed to backend container)
GOOGLE_LOCATION_API=
GOOGLEMAP_API_URL=https://maps.googleapis.com/maps/api/place/autocomplete/json
GOOGLEMAP_API_TIMEZONE_URL=https://maps.googleapis.com/maps/api/place/details/json
BGG_API_URL=https://api.geekdo.com/xmlapi2/search?type=boardgame&query=
BGG_API_TOKEN=
