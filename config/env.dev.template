# Development: standalone frontend (Yew/Tauri) talking to backend.
# Copy to .env.dev: ./config/setup-env.sh dev
# Used by: scripts/start-front.sh

RUST_ENV=development
RUST_LOG=debug
LOG_FORMAT=pretty
LOG_SERVICE_NAME=stg-backend

# Docker bind mounts (Surreal, Redis, backend files). Relative → repo-root data/dev (see docs/PROJECT_STRUCTURE.md).
VOLUME_PATH=data/dev

# Ports (defaults: SurrealDB 50001, backend 50002, frontend 50003)
SURREALDB_PORT=50001
BACKEND_PORT=50002
BACKEND_URL=http://localhost:${BACKEND_PORT}
FRONTEND_PORT=50003

# Observability (./scripts/start-observability.sh). Default 50004 in dev (STG port range; easier Hyper-V port forward than 3000).
#GRAFANA_PORT=50004
#GRAFANA_ADMIN_USER=admin
#GRAFANA_ADMIN_PASSWORD=changeme

# SurrealDB (backend uses these; 50001 is exposed for tools/Surrealist). Use 127.0.0.1 so localhost DNS issues don't break connection.
SURREAL_URL=http://127.0.0.1:50001
SURREAL_NS=stg_rd
SURREAL_DB=stg_rd
SURREAL_USER=root
SURREAL_PASSWORD=root

# Optional: prod Surreal exports (*.surql.gz) for local dev seed — see docs/DAILY_WORKFLOW.md
#SURREAL_SEED_DIR=/home/thebogie/work/stg-data/prod-db

# Optional API keys
GOOGLE_LOCATION_API=
BGG_API_TOKEN=

# Optional (AI): self-hosted LLM base URL for the backend. Default is internal Compose service.
#LLM_BASE_URL=http://ollama:11434
# Ollama port exposed on host (dev-debug flow). Backend on host should use:
#   LLM_BASE_URL=http://127.0.0.1:${OLLAMA_PORT}
OLLAMA_PORT=11434

# Sell a Game — ephemeral listing photos (see docs/sell-game-guardrails.md)
#SELL_IMAGE_DIR=/app/data/sell-images
#SELL_IMAGE_MAX_BYTES=8388608
#SELL_IMAGE_MAX_COUNT=8
#SELL_IMAGE_TTL_HOURS=24

# Playwright: local = spawn node on host (hybrid dev); queue = Redis worker container
#PLAYWRIGHT_MODE=local
#NODE_BIN=node
#BGG_PLAYWRIGHT_SCRIPT=tools/bgg-marketplace/fill-listing.mjs
#BGG_HEADLESS=1
#BGG_AUTO_SUBMIT=0

# AWS Bedrock vision extraction (optional; stub used when unset)
#AWS_REGION=us-east-1
#BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
