# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# SurrealDB Configuration (backend uses WebSocket; URL can be http:// or ws://)
SURREAL_URL=http://localhost:50001
SURREAL_NS=stg_rd
SURREAL_DB=stg_rd
SURREAL_USER=root
SURREAL_PASSWORD=root

# Redis Configuration
REDIS_URL=redis://127.0.0.1/

# Google Places API Configuration
GOOGLE_API_URL=https://maps.googleapis.com/maps/api/
GOOGLE_LOCATION_API=your_google_places_api_key_here
GOOGLEMAP_API_TIMEZONE_URL=https://maps.googleapis.com/maps/api/timezone/json
# NOTE: Place this file at the top-level of the repository as .env.development or .env.production
