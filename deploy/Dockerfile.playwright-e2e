# Pre-baked Playwright E2E image: Node deps + Chromium installed at *build* time.
# Runtime only mounts live specs/config; no CDN download during ./scripts/full-prod-test.sh.
#
# Build (from repo root, needs outbound access to npm + Playwright CDN once):
#   ./scripts/build-playwright-e2e-image.sh
#
# Rebuild when package-lock.json changes @playwright/test version.

ARG PLAYWRIGHT_VERSION=1.59.1
FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-noble

WORKDIR /work

# Install test runner + browsers once in the image layer.
# We intentionally do NOT copy the test specs/config into the image; they are mounted at runtime
# by `scripts/run-playwright-e2e-docker.sh` so the image is just the stable execution environment.
COPY package.json package-lock.json ./

RUN npm ci \
    && npx playwright install chromium

# Tests must not re-download browsers when the stack is already up.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# Default; run-playwright-e2e-docker.sh overrides with mounted specs + _build output.
CMD ["npm", "exec", "playwright", "test"]
