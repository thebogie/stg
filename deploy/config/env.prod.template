# Production: Docker full stack (SurrealDB + Redis + backend + frontend).
# When using the deploy folder on the server: copy to config/.env.prod and set VOLUME_PATH.
#   cp deploy/config/env.prod.template deploy/config/.env.prod
#   # Edit deploy/config/.env.prod: set VOLUME_PATH, SURREAL_PASSWORD, etc.

RUST_ENV=production
RUST_LOG=info

# Data dir for Docker volumes. On the server use an absolute path OUTSIDE the deploy folder
# (e.g. /opt/stg/data) so persistent data is not under the directory you scp. Do not use ./docker-data in production.
VOLUME_PATH=/opt/stg/data

# Admin: comma-separated emails get admin UI + admin API access
#ADMIN_EMAILS=admin@example.com

# Ports (host mapping: SurrealDB 50001, backend 50002, frontend 50003)
SURREALDB_PORT=50001
BACKEND_PORT=50002
FRONTEND_PORT=50003
REDIS_PORT=6379

# SurrealDB (inside containers: ws://surrealdb:8000)
SURREAL_NS=stg_rd
SURREAL_DB=stg_rd
SURREAL_USER=root
SURREAL_PASSWORD=root

# Optional API keys (passed to backend container)
GOOGLE_LOCATION_API=
GOOGLEMAP_API_URL=https://maps.googleapis.com/maps/api/place/autocomplete/json
GOOGLEMAP_API_TIMEZONE_URL=https://maps.googleapis.com/maps/api/place/details/json
BGG_API_URL=https://api.geekdo.com/xmlapi2/search?type=boardgame&query=
BGG_API_TOKEN=

# Sell / Playwright worker (Docker stack)
PLAYWRIGHT_MODE=queue
#PLAYWRIGHT_JOB_TTL_SECONDS=900
#PLAYWRIGHT_STATUS_TTL_SECONDS=3600
#BGG_HEADLESS=1
#BGG_AUTO_SUBMIT=0

# Optional (AI): self-hosted LLM base URL for the backend. Default is internal Compose service.
#LLM_BASE_URL=http://ollama:11434
# BGG reference data: run deploy/migrations (bgg_catalog table), copy CSV to the server, then:
#   cd deploy && ./import_bgg_catalog.sh /opt/stg/data/bgg/boardgames_ranks.csv
# (uses the backend Docker image; no Rust on the server). Dev: cargo run -p backend --bin import_bgg_catalog -- ...
