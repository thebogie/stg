# Production API URL for Tauri desktop/mobile app.
# Set this when running the Tauri app so it talks to your production backend.
# (The app reads STG_API_URL at runtime via get_app_config.)
#
# Example (same origin as web):
#   export STG_API_URL=https://smacktalkgaming.com
# Example (API subdomain):
#   export STG_API_URL=https://api.smacktalkgaming.com
#
# Release builds bake this default via front/tauri/src-tauri/build.rs when unset.
# CI build-tauri sets STG_API_URL for the compile step (see .github/workflows/build-and-push.yml).

STG_API_URL=https://smacktalkgaming.com
