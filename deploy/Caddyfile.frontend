# Production Caddyfile for the STG web frontend container.
# Serves static files from /usr/share/caddy and proxies /api/* to the backend.
# Used by deploy/docker-compose.full.yml (mount over the image's default Caddyfile).
#
# Intended to sit behind Traefik (or another reverse proxy) that terminates SSL.
# Traefik forwards HTTP to this container; we pass X-Forwarded-* through to the
# backend so it sees the original scheme (https) and client IP.

{
    auto_https off
}

:50003 {
    # route {} preserves directive order. Without it, Caddy may evaluate try_files
    # before /api/* and return index.html for API paths (breaks WASM JSON parsing).
    route {
        handle /api/* {
            reverse_proxy backend:50002 {
                header_up X-Forwarded-Proto {request.header.X-Forwarded-Proto}
                header_up X-Forwarded-For {request.header.X-Forwarded-For}
                header_up Host {request.header.Host}
            }
        }
        handle /health {
            reverse_proxy backend:50002 {
                header_up X-Forwarded-Proto {request.header.X-Forwarded-Proto}
                header_up X-Forwarded-For {request.header.X-Forwarded-For}
                header_up Host {request.header.Host}
            }
        }
        handle /version {
            reverse_proxy backend:50002 {
                header_up X-Forwarded-Proto {request.header.X-Forwarded-Proto}
                header_up X-Forwarded-For {request.header.X-Forwarded-For}
                header_up Host {request.header.Host}
            }
        }

        @wasm path *.wasm
        handle @wasm {
            root * /usr/share/caddy
            header Content-Type "application/wasm"
            file_server
        }
        @static path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg
        handle @static {
            root * /usr/share/caddy
            header Cache-Control "public, max-age=31536000, immutable"
            file_server
        }

        handle {
            root * /usr/share/caddy
            try_files {path} /index.html
            file_server
        }
    }

    header {
        X-Content-Type-Options "nosniff"
        -Server
    }
}
